{
  "name": "gitrep",
  "productName": "GitRep",
  "desktopName": "gitrep.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-repo git client",
  "author": "Kevin Jordil",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "smoke": "electron-vite build && GITREP_SMOKE=1 electron . --no-sandbox",
    "package": "electron-vite build && electron-builder --linux dir",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage deb pacman --x64 --publish never",
    "dist:win": "electron-vite build && electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "build": {
    "appId": "local.gitrep",
    "productName": "GitRep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "linux": {
      "target": "dir",
      "category": "Development",
      "maintainer": "Kevin Jordil <kevin.jordil@outlook.com>",
      "synopsis": "Local multi-repo git client",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "icon": "resources/icon.png",
    "artifactName": "GitRep-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "GitRep-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "GitRep-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "4.4.3",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
