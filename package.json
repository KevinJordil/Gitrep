{
  "name": "gitrep",
  "productName": "GitRep",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-repo git client",
  "author": "Kevin Jordil",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview --noSandbox",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "smoke": "electron-vite build && GITREP_SMOKE=1 electron . --no-sandbox",
    "package": "electron-vite build && electron-builder --linux dir"
  },
  "build": {
    "appId": "local.gitrep",
    "productName": "GitRep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "linux": {
      "target": "dir",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
